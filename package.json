{
  "name": "open-source-contribution-intelligence",
  "version": "0.1.0",
  "description": "Analyzes public GitHub repositories to help developers discover meaningful contribution opportunities",
  "scripts": {
    "benchmark": "node benchmarks/run-parser-benchmark.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "compile": "tsc -p tsconfig.src.json",
    "test": "tsc -p tsconfig.src.json && node --test \"dist/ingest/*.test.js\" \"dist/storage/*.test.js\"",
    "bootstrap": "node scripts/bootstrap-deps.js"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "^8.13.0",
    "typescript": "5.9"
  }
}
